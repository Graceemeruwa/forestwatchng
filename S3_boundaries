/**** S3 - Reserve boundaries (owner: Abiodun) ****
 * Goal: save one clean boundary per reserve as an asset:
 *   <ASSET_ROOT>/boundary_omo  and  <ASSET_ROOT>/boundary_gambari
 *
 * Steps
 * 1. Run. For each reserve the Console shows how many WDPA matches were found,
 *    then each match's full attributes and its mapped area (ha). Matches are drawn on the map.
 * 2. Check each match against a published map of the reserve (Omo is about 130,000 ha).
 * 3. If a match is right, set its position in the list (0 = first) in CHOSEN below,
 *    run again, and start the export task in the Tasks tab.
 * 4. If there is no match, or a better (official) boundary is available, upload it instead:
 *    Assets > NEW > Shape files (.shp .shx .dbf .prj, zipped or together)
 *    and save it with the same asset name (boundary_omo / boundary_gambari).
 *    Replacing the asset later is fine: every other script reads it by name.
 */
var cfg = require('users/forestwatchng/forestwatchng:lib/config');
var sites = require('users/forestwatchng/forestwatchng:lib/sites');

// Position of the correct match in each list (0 = first). Leave null to skip export.
var CHOSEN = {
  omo: null,
  gambari: null
};

Object.keys(cfg.SITES).forEach(function(key) {
  var matches = sites.searchWDPA(cfg.SITES[key].name);
  var list = matches.toList(10);
  print(key + ': number of WDPA matches', matches.size());

  // Full attributes of each match (works whatever the WDPA field names are).
  list.evaluate(function(feats) {
    if (!feats) { return; }
    feats.forEach(function(f, i) {
      var feat = ee.Feature(list.get(i));
      print(key + ' match ' + i + ': attributes', feat.toDictionary());
      print(key + ' match ' + i + ': mapped area (ha)',
        feat.geometry().area(100).divide(10000).round());
    });
  });

  Map.addLayer(matches, {color: key === 'omo' ? 'yellow' : 'cyan'}, key + ' (WDPA matches)');

  var idx = CHOSEN[key];
  if (idx !== null) {
    var chosen = ee.FeatureCollection([ee.Feature(list.get(idx)).set('site', key)]);
    Export.table.toAsset({
      collection: chosen,
      description: 'S3_boundary_' + key,
      assetId: cfg.ASSET_ROOT + '/boundary_' + key
    });
  }
});

Map.setCenter(3.9, 7.0, 8);
