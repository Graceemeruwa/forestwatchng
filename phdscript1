/**
 * ============================================================================
 * BOUNDARIES AND GEDI AVAILABILITY — SINGLE SCRIPT, ONE RUN
 * ----------------------------------------------------------------------------
 * Project: forestwatchng
 *
 * Paste, press Run once. Nothing needs to exist in the cloud project first.
 *
 * ----------------------------------------------------------------------------
 * THE FILTER
 *
 *   Adopted:  l4_quality_flag == 1
 *             degrade_flag == 0
 *             sensitivity >= 0.98
 *             terrain slope < 20 degrees
 *
 *   l4_quality_flag already imposes a beam sensitivity threshold of 0.95, and
 *   l2_quality_flag a threshold of 0.90, so l2_quality_flag and any
 *   sensitivity condition at or below 0.95 are redundant. Over Gambari,
 *   sensitivity runs from exactly 0.9500 to 0.9965, which shows the floor
 *   directly.
 *
 *   0.98 follows the L4A user guide's guidance for dense tropical forest. At
 *   Gambari it retains 826 of 3,355 footprints, gives a mean of 57.6 Mg/ha
 *   against 40.3, and a maximum of 332.0 against 520.5.
 *
 *   predictor_limit_flag and response_limit_flag are not available in the
 *   Earth Engine product: both carry only the value 255, the no-data fill.
 *   Filtering on them requires the granules from ORNL DAAC directly. The guide
 *   codes them 0 in bounds, 1 below the lower bound and 2 above the upper
 *   bound, and advises care with such observations rather than exclusion.
 *
 * Both the basic and the adopted filter are reported throughout so the effect
 * of the sensitivity threshold stays visible.
 * ============================================================================
 */
// ================================================================== CONFIG
// Must match the Cloud project the Code Editor is running under. The project
// name appears at the top of the Assets tab.
var PROJECT = 'myphdresearch';

var DOMAIN   = ee.Geometry.Rectangle([2.7, 5.8, 6.5, 8.5]);
var GRID_DEG = 0.25;        // ~27 km cells, 150 across the domain
var SLOPE_MAX = 20;         // degrees
var SENSITIVITY_MIN = 0.98; // above the 0.95 that l4_quality_flag imposes

// Implausibility threshold for the outlier check in section C. Nothing is
// masked by it; it only counts how many footprints sit above it.
var AGBD_CEILING = 700;

// Set false to queue only the basic-filter domain export and halve compute.
var EXPORT_BOTH_FILTERS = true;

// The UI teak plantation is not gazetted and absent from WDPA. At 87 ha it
// holds roughly one footprint, so it stays a field validation site rather
// than a GEDI co-location site. Set this only to confirm that figure.
var UI_ASSET = null;        // e.g. 'projects/' + PROJECT + '/assets/ui_teak'

Map.setCenter(4.2, 7.1, 8);

/* ===========================================================================
 * A — RESERVE BOUNDARIES FROM WDPA
 *
 * Exact name matches. A substring search on "ambari" also returns Kambari, a
 * different place, and "Akure" and "Akure-Ofosu" are separate reserves.
 * REP_AREA is zero for every Nigerian forest reserve in WDPA, so area is
 * computed from the polygon in UTM 31N. All three centroids are west of 6 E,
 * so zone 31N is correct for all of them.
 * ======================================================================== */
var SITES_ASSET = 'projects/' + PROJECT + '/assets/study_sites';

// false resolves the boundaries from WDPA in this script and queues the asset
// export. Switch to true only after that export task has completed, and only
// if the entry at SITES_ASSET is a table. An Earth Engine folder of that name
// is a different kind of asset and cannot be read as a FeatureCollection.
var USE_ASSET = 'True';

var ng = ee.FeatureCollection('WCMC/WDPA/current/polygons')
           .filter(ee.Filter.eq('ISO3', 'NGA'));

function siteFrom(wdpaName, label) {
  return ee.Feature(ng.filter(ee.Filter.eq('NAME', wdpaName)).first())
           .set('site', label);
}

var sitesFromWdpa = ee.FeatureCollection([
  siteFrom('Omo',         'Omo'),
  siteFrom('Gambari',     'Gambari'),
  siteFrom('Akure-Ofosu', 'Akure_Ofosu')
]).map(function (f) {
  return f.set({
    utm_area_ha: f.geometry().area({maxError: 10, proj: 'EPSG:32631'}).divide(10000),
    gis_area_ha: ee.Number(f.get('GIS_AREA')).multiply(100),
    lon: f.geometry().centroid(100).coordinates().get(0),
    lat: f.geometry().centroid(100).coordinates().get(1)
  });
});

var sites = USE_ASSET ? ee.FeatureCollection(SITES_ASSET) : sitesFromWdpa;

print('===== A. BOUNDARIES =====');
print('source:', USE_ASSET ? SITES_ASSET : 'WDPA, resolved in this script');
print('site:',         sites.aggregate_array('site'));
print('WDPA site ID:', sites.aggregate_array('SITE_ID'));
print('verification:', sites.aggregate_array('VERIF'));
print('area ha, UTM:', sites.aggregate_array('utm_area_ha'));
print('area ha, GIS:', sites.aggregate_array('gis_area_ha'));
print('centroid lon:', sites.aggregate_array('lon'));
print('centroid lat:', sites.aggregate_array('lat'));
// Expect 131,875 · 17,164 · 39,273 ha. A change means the WDPA record moved.

// Queued while USE_ASSET is false. Start study_sites_asset in the Tasks tab.
// The path must be free: no folder and no earlier table of the same name.
if (!USE_ASSET) {
  Export.table.toAsset({
    collection: sitesFromWdpa,
    description: 'study_sites_asset',
    assetId: SITES_ASSET
  });
  Export.table.toDrive({
    collection: sitesFromWdpa,
    description: 'study_sites_shapefile',
    fileFormat: 'SHP'
  });
}

/* ===========================================================================
 * GEDI MASKING
 * ======================================================================== */
var gediRaw = ee.ImageCollection('LARSE/GEDI/GEDI04_A_002_MONTHLY');
var slope = ee.Terrain.slope(ee.Image('NASA/NASADEM_HGT/001').select('elevation'));

/** BASIC: l4_quality_flag already carries sensitivity >= 0.95 and l2 = 1. */
function maskBasic(im) {
  return im.updateMask(im.select('l4_quality_flag').eq(1))
           .updateMask(im.select('degrade_flag').eq(0))
           .select('agbd');
}

/**
 * STRICT: the same, with the beam sensitivity threshold raised to 0.98.
 * The two limit flags are deliberately absent. See the header.
 */
function maskStrict(im) {
  return im.updateMask(im.select('l4_quality_flag').eq(1))
           .updateMask(im.select('degrade_flag').eq(0))
           .updateMask(im.select('sensitivity').gte(SENSITIVITY_MIN))
           .select('agbd');
}

/** All bands retained, for the per-algorithm inspection in section C. */
function maskBasicAll(im) {
  return im.updateMask(im.select('l4_quality_flag').eq(1))
           .updateMask(im.select('degrade_flag').eq(0));
}

/**
 * Masked mosaic for one geometry. Two requirements.
 *
 * filterBounds must precede mosaic, so that only the granules intersecting the
 * geometry are mosaicked.
 *
 * The blank fallback keeps a fully masked agbd band present where no granule
 * intersects the geometry, so reduceRegion always returns the expected keys.
 */
function gediFor(geom, maskFn) {
  var ic = gediRaw.filterBounds(geom).map(maskFn);
  var blank = ee.Image(0).rename('agbd').selfMask();
  return ee.Image(ee.Algorithms.If(ic.size().gt(0), ic.mosaic(), blank))
           .rename('agbd')
           .updateMask(slope.lt(SLOPE_MAX))
           .clip(geom);
}

/**
 * Combined reducers produce suffixed keys: agbd_count, agbd_mean and so on.
 * An output is named after the band alone only for a single-output reducer.
 */
function reduce(img, geom, reducer) {
  return img.reduceRegion({
    reducer: reducer,
    geometry: geom,
    scale: 25,            // native resolution; do not coarsen
    maxPixels: 1e9,
    tileScale: 16
  });
}

var STATS = ee.Reducer.count()
  .combine(ee.Reducer.mean(),   '', true)
  .combine(ee.Reducer.stdDev(), '', true)
  .combine(ee.Reducer.minMax(), '', true)
  .combine(ee.Reducer.percentile([5, 50, 95]), '', true);

var COUNT_MEAN = ee.Reducer.count().combine(ee.Reducer.mean(), '', true);

/* ===========================================================================
 * B — PER RESERVE, BASIC AGAINST STRICT
 *
 * Reference values from the basic filter run on these boundaries:
 *   Omo         28,751 · mean 56.0 · median 39.6 · p95 135.2 · max 2,545.2
 *   Gambari      3,355 · mean 40.3 · median 29.9 · p95 106.4 · max   520.5
 *   Akure-Ofosu  6,376 · mean 35.0 · median 23.1 · p95  98.7 · max   498.3
 * ======================================================================== */
print('===== B. FOOTPRINTS PER RESERVE =====');

['Omo', 'Gambari', 'Akure_Ofosu'].forEach(function (name) {
  var geom = sites.filter(ee.Filter.eq('site', name)).first().geometry();
  print('--- ' + name + ' ---');
  print('  BASIC :', reduce(gediFor(geom, maskBasic),  geom, STATS));
  print('  STRICT:', reduce(gediFor(geom, maskStrict), geom, STATS));
});

if (UI_ASSET) {
  var ui = ee.FeatureCollection(UI_ASSET).geometry();
  print('--- UI teak ---');
  print('  area_ha:', ui.area(10).divide(10000));
  print('  BASIC :', reduce(gediFor(ui, maskBasic),  ui, STATS));
  print('  STRICT:', reduce(gediFor(ui, maskStrict), ui, STATS));
} else {
  print('--- UI teak skipped, not in WDPA. Set UI_ASSET to include it. ---');
}

/* ===========================================================================
 * C — CHASING THE OMO OUTLIER
 *
 * Omo returned a maximum of 2,545 Mg/ha inside the gazetted boundary, which
 * no tropical forest holds. This section asks how many footprints sit above
 * the plausible ceiling, whether the sensitivity threshold removes them, and
 * whether they concentrate in one L4A algorithm group. selected_algorithm
 * takes values 1, 2, 5 and 10 at Gambari, and the choice of algorithm is a
 * known source of variation in L4A biomass.
 * ======================================================================== */
print('===== C. OMO OUTLIER CHECK =====');

var omoGeom = sites.filter(ee.Filter.eq('site', 'Omo')).first().geometry();

[['BASIC', maskBasic], ['STRICT', maskStrict]].forEach(function (pair) {
  var img = gediFor(omoGeom, pair[1]);
  print('  ' + pair[0] + ', footprints above ' + AGBD_CEILING + ' Mg/ha:',
        reduce(img.updateMask(img.gt(AGBD_CEILING)), omoGeom, COUNT_MEAN));
});

var omoAll = gediRaw.filterBounds(omoGeom).map(maskBasicAll).mosaic()
               .updateMask(slope.lt(SLOPE_MAX)).clip(omoGeom);

print('  selected_algorithm frequency:',
      reduce(omoAll.select('selected_algorithm'),
             omoGeom, ee.Reducer.frequencyHistogram()));

print('  agbd by algorithm group:',
      omoAll.select(['agbd', 'selected_algorithm']).reduceRegion({
        reducer: ee.Reducer.mean()
                   .combine(ee.Reducer.max(), '', true)
                   .combine(ee.Reducer.count(), '', true)
                   .group({groupField: 1, groupName: 'algorithm'}),
        geometry: omoGeom, scale: 25, maxPixels: 1e9, tileScale: 16}));

/* ===========================================================================
 * D — AGBD BY ALGORITHM SETTING GROUP
 *
 * The product carries a separate AGBD prediction for every algorithm setting
 * group, with a matching quality flag and sensitivity value, so the selection
 * can be examined rather than accepted. Mean biomass at Omo varies 5.6-fold
 * across the selected groups: 31.7 Mg/ha for group 1, 40.6 for group 2, 71.7
 * for group 10 and 177.0 for group 5.
 *
 * Each group is run on its own quality flag and sensitivity, which is the fair
 * comparison. Output is compact arrays rather than one object per group.
 * ======================================================================== */
print('===== D. AGBD BY ALGORITHM SETTING GROUP =====');

var ALGS = ['a1', 'a2', 'a3', 'a4', 'a5', 'a6', 'a10'];

var ALG_STATS = ee.Reducer.count()
  .combine(ee.Reducer.mean(), '', true)
  .combine(ee.Reducer.max(),  '', true)
  .combine(ee.Reducer.percentile([50]), '', true);

function algImage(geom, a) {
  var ic = gediRaw.filterBounds(geom).map(function (im) {
    return im.updateMask(im.select('degrade_flag').eq(0))
             .updateMask(im.select('l4_quality_flag_' + a).eq(1))
             .updateMask(im.select('sensitivity_' + a).gte(SENSITIVITY_MIN))
             .select(['agbd_' + a], ['agbd']);
  });
  var blank = ee.Image(0).rename('agbd').selfMask();
  return ee.Image(ee.Algorithms.If(ic.size().gt(0), ic.mosaic(), blank))
           .rename('agbd')
           .updateMask(slope.lt(SLOPE_MAX))
           .clip(geom);
}

['Omo', 'Gambari', 'Akure_Ofosu'].forEach(function (name) {
  var g = sites.filter(ee.Filter.eq('site', name)).first().geometry();

  var rows = ee.FeatureCollection(ALGS.map(function (a) {
    var d = ee.Dictionary(reduce(algImage(g, a), g, ALG_STATS));
    return ee.Feature(null, {
      alg: a,
      n:      ee.Algorithms.If(d.contains('agbd_count'), d.get('agbd_count'), 0),
      mean:   ee.Algorithms.If(d.contains('agbd_mean'),  d.get('agbd_mean'),  null),
      median: ee.Algorithms.If(d.contains('agbd_p50'),   d.get('agbd_p50'),   null),
      max:    ee.Algorithms.If(d.contains('agbd_max'),   d.get('agbd_max'),   null)
    });
  }));

  print('--- ' + name + ' ---');
  print('  alg   :', rows.aggregate_array('alg'));
  print('  n     :', rows.aggregate_array('n'));
  print('  mean  :', rows.aggregate_array('mean'));
  print('  median:', rows.aggregate_array('median'));
  print('  max   :', rows.aggregate_array('max'));
});

/* ===========================================================================
 * E — FOOTPRINT TABLE EXPORT
 *
 * agbd_a5 and agbd_a10 are available on an identical set of footprints at
 * every reserve, with a10 close to half of a5 throughout. This exports one row
 * per footprint carrying every candidate prediction side by side, for the
 * paired comparison, for placing plots where footprints are, and for joining
 * field measurements to later.
 *
 * Masked on the basic filter only. Sensitivity is a column rather than a
 * filter, so thresholds can be varied in analysis instead of being fixed here.
 *
 * dropNulls is true, so a row appears only where every listed prediction
 * exists. Expect fewer rows than the basic footprint count. That is the right
 * basis for comparing algorithms, which needs complete cases, and the
 * shortfall itself is worth recording.
 * ======================================================================== */
var TABLE_BANDS = [
  'agbd', 'agbd_se', 'agbd_a2', 'agbd_a5', 'agbd_a6', 'agbd_a10',
  'sensitivity', 'sensitivity_a5', 'selected_algorithm',
  'lon_lowestmode', 'lat_lowestmode'
];

function footprintImage(geom) {
  return gediRaw.filterBounds(geom)
    .map(function (im) {
      return im.updateMask(im.select('l4_quality_flag').eq(1))
               .updateMask(im.select('degrade_flag').eq(0))
               .select(TABLE_BANDS);
    })
    .mosaic()
    .updateMask(slope.lt(SLOPE_MAX))
    .clip(geom);
}

['Omo', 'Gambari', 'Akure_Ofosu'].forEach(function (name) {
  var g = sites.filter(ee.Filter.eq('site', name)).first().geometry();
  var pts = footprintImage(g).sample({
    region: g, scale: 25, geometries: false, dropNulls: true, tileScale: 16
  }).map(function (f) { return f.set('site', name); });

  Export.table.toDrive({
    collection: pts,
    description: 'GEDI_footprints_' + name,
    fileFormat: 'CSV',
    selectors: TABLE_BANDS.concat(['site'])
  });
});

/* ===========================================================================
 * F — DOMAIN COUNT, TILED AND EXPORTED
 *
 * One reduceRegion over 12.5 million hectares at 25 m is roughly 200 million
 * pixels and will not complete interactively, so the domain is split into
 * cells, counted separately and exported.
 *
 * Do not coarsen the scale to make this faster. At 100 m a cell holding
 * several footprints is counted once, and that undercount cannot be corrected
 * afterwards. If a tile fails, lower GRID_DEG to 0.1.
 * ======================================================================== */
var xs = ee.List.sequence(2.7, 6.5 - GRID_DEG, GRID_DEG);
var ys = ee.List.sequence(5.8, 8.5 - GRID_DEG, GRID_DEG);

var grid = ee.FeatureCollection(
  xs.map(function (x) {
    return ys.map(function (y) {
      x = ee.Number(x); y = ee.Number(y);
      return ee.Feature(
        ee.Geometry.Rectangle([x, y, x.add(GRID_DEG), y.add(GRID_DEG)]),
        {x: x, y: y});
    });
  }).flatten()
);

print('===== F. DOMAIN EXPORT =====');
print('grid cells:', grid.size());

function countGrid(maskFn) {
  return grid.map(function (cell) {
    var geom = cell.geometry();
    var d = ee.Dictionary(reduce(gediFor(geom, maskFn), geom, COUNT_MEAN));
    return cell.set({
      n: ee.Algorithms.If(d.contains('agbd_count'), d.get('agbd_count'), 0),
      mean_agbd: ee.Algorithms.If(d.contains('agbd_mean'), d.get('agbd_mean'), null)
    });
  });
}

Export.table.toDrive({
  collection: countGrid(maskBasic),
  description: 'GEDI_domain_counts_basic',
  fileFormat: 'CSV',
  selectors: ['x', 'y', 'n', 'mean_agbd']
});

if (EXPORT_BOTH_FILTERS) {
  Export.table.toDrive({
    collection: countGrid(maskStrict),
    description: 'GEDI_domain_counts_strict',
    fileFormat: 'CSV',
    selectors: ['x', 'y', 'n', 'mean_agbd']
  });
}

print('Tasks queued: boundary asset, boundary shapefile, and the domain counts.');

/* ===========================================================================
 * G — MAP
 * ======================================================================== */
var l4b = ee.Image('LARSE/GEDI/GEDI04_B_002').select('MU').clip(DOMAIN);
Map.addLayer(l4b, {min: 0, max: 400, palette: ['fff7ec', '97BC62', '2C5F2D']},
             'GEDI L4B mean AGBD, 1 km');

print('L4B domain summary:',
      l4b.reduceRegion({
        reducer: ee.Reducer.mean().combine(ee.Reducer.minMax(), '', true),
        geometry: DOMAIN, scale: 1000, maxPixels: 1e9, bestEffort: true}));

Map.addLayer(gediFor(omoGeom, maskStrict),
  {min: 0, max: 400, palette: ['f7fcf5', '97BC62', '2C5F2D', '0b2e0c']},
  'Omo footprints, strict filter');

// Simplified for rendering only. Never for area computation.
Map.addLayer(sites.map(function (f) {
  return f.setGeometry(f.geometry().simplify(200));
}).style({color: 'red', fillColor: '00000000', width: 2}), {}, 'Reserves');

/* ===========================================================================
 * RECORD FOR CHAPTER THREE
 *
 *   The filter definition, stated exactly, since the counts cannot be
 *   reproduced without it, together with the reason the two limit flags are
 *   not used: they are fill-valued at 255 throughout the Earth Engine product.
 *
 *   Per reserve under both filters: area, count, mean, standard deviation,
 *   5th, 50th and 95th percentiles, minimum and maximum.
 *   Domain totals under both filters.
 *   The retention rate of the strict filter, which at Gambari is 24.5 per cent.
 *
 * Each count is a 25 m pixel of the rasterised product, so footprints
 * overlapping within one pixel are counted once. That is the right figure for
 * independent training labels and a slight undercount of orbital footprints.
 *
 * IF SOMETHING FAILS
 *   memory in B or C   raise tileScale to 32, drop maxPixels to 1e8, or run
 *                      one reserve per execution
 *   a tile in D        lower GRID_DEG to 0.1
 *   quota              register forestwatchng at Contributor Tier, or set
 *                      EXPORT_BOTH_FILTERS to false
 * ======================================================================== */
