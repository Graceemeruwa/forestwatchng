/**** R2 - Risk model: train, test honestly, replay 2025 (owner: Abiodun) ****
 * Needs R1 exports: risk_train_<site>, risk_feat_<site>_2024.
 *
 * Runs in 3 steps so the browser does not freeze. Set STEP, click Run, wait, then go on.
 *
 * STEP 1 - Tests (prints only, no map). Run one at a time with TEST = 'a' ... 'e'.
 *   a. Spatial-block test: train on 4 of the 5 folds (2 km blocks), predict the 5th, repeat.
 *      Score = AUC (0.5 = coin flip, 1 = perfect ranking).
 *   b. The simple rule "closest to recent loss" scored on the same samples.
 *   c. Time test: train on T = 2017-2020, test on T = 2021-2022.
 *   d. Site test: set APPLY_SITE = 'gambari' (needs R1 run for Gambari).
 *   e. Which inputs the model uses most.
 *   f. Test a again with only the inputs that change over time (memorisation check).
 *
 * STEP 2 - Export the risk score (starts one task; run it from the Tasks tab)
 *   Risk score from inputs at the end of 2024 (no 2025 data used) -> risk_score_<site>_2024.
 *
 * STEP 3 - Replay and map (needs the STEP 2 asset)
 *   How much of the forest actually lost in 2025 (Hansen) fell inside the top 10% and 20%
 *   riskiest forest, compared with the simple rule. Then the map, and exports for the app
 *   and for ArcGIS Pro / QGIS. If the model does not beat the simple rule, we say so.
 *
 * The model is trained on balanced samples (1 lost : 3 stayed), so its output is a
 * relative score for ranking, not a true probability. The map shows the top 10% / 20%.
 * Lead time (how many weeks before a GFW alert we flagged an area) is checked in P4.
 */
var cfg = require('users/forestwatchng/forestwatchng:lib/config');
var sites = require('users/forestwatchng/forestwatchng:lib/sites');

var STEP = 1;                    // 1 = tests, 2 = export risk score, 3 = replay + map
var TEST = 'a';                  // STEP 1 only: run one test at a time: 'a', 'b', 'c', 'd' (Gambari), 'e', 'f'
var TRAIN_SITE = 'omo';
var APPLY_SITE = 'omo';          // 'gambari' = independent test on a site the model never saw
var EXPORT = false;              // STEP 3 only: export the final risk layer
var SEED = 42;
var TREES = 150;
var FOLDS = 5;
var CRS = 'EPSG:32631';
var SCALE = 30;
var FEATURES = ['d_loss', 'loss_dens', 'd_edge', 'forest_dens', 'd_road', 'd_settle',
                'elev', 'slope', 'inside', 'd_bound'];

function newRF() {
  return ee.Classifier.smileRandomForest({numberOfTrees: TREES, minLeafPopulation: 5, seed: SEED})
    .setOutputMode('PROBABILITY');
}

var train = ee.FeatureCollection(cfg.ASSET_ROOT + '/risk_train_' + TRAIN_SITE);
var aoi = sites.aoi(APPLY_SITE);
var feat = ee.Image(cfg.ASSET_ROOT + '/risk_feat_' + APPLY_SITE + '_2024');
var scoreId = cfg.ASSET_ROOT + '/risk_score_' + APPLY_SITE + '_2024';

// AUC worked out on the server from two small histograms (lost vs stayed, 200 bins of the
// score from 0 to 1), so only a few hundred numbers come back to the browser.
function printAuc(title, scored) {
  scored.reduceColumns(ee.Reducer.fixedHistogram(0, 1.000001, 200).group(1, 'loss'), ['p', 'loss'])
    .evaluate(function(r, err) {
      if (err) { print(title + ': error', err); return; }
      var h = {};
      r.groups.forEach(function(g) { h[g.loss] = g.histogram.map(function(b) { return b[1]; }); });
      if (!h[0] || !h[1]) { print(title + ': n/a'); return; }
      var nNeg = 0, nPos = 0, sum = 0;
      h[0].forEach(function(c) { nNeg += c; });
      h[1].forEach(function(c) { nPos += c; });
      var negBelow = 0;
      for (var i = 0; i < h[0].length; i++) {
        sum += h[1][i] * (negBelow + h[0][i] / 2);
        negBelow += h[0][i];
      }
      print(title + ': AUC = ' + (sum / (nPos * nNeg)).toFixed(3) + ' (' + (nPos + nNeg) + ' samples)');
    });
}

// ===== STEP 1: tests ===================================================================
if (STEP === 1) {
  if (TEST === 'a') {
    var cv = ee.FeatureCollection(ee.List.sequence(0, FOLDS - 1).map(function(k) {
      k = ee.Number(k).int();
      var m = newRF().train(train.filter(ee.Filter.neq('fold', k)), 'loss', FEATURES);
      return train.filter(ee.Filter.eq('fold', k)).classify(m, 'p');
    })).flatten();
    printAuc('a. Spatial-block test (unseen 2 km blocks)', cv);
  }
  if (TEST === 'b') {
    // Rule score: 1 at recent loss, 0 at 5 km or more.
    printAuc('b. Simple rule (closest to recent loss), same samples',
      train.map(function(f) { return f.set('p', ee.Number(1).subtract(ee.Number(f.get('d_loss')).divide(5000))); }));
  }
  if (TEST === 'c') {
    var early = newRF().train(train.filter(ee.Filter.lte('T', 20)), 'loss', FEATURES);
    printAuc('c. Time test (train 2017-2020, test 2021-2022)',
      train.filter(ee.Filter.gte('T', 21)).classify(early, 'p'));
  }
  if (TEST === 'd') {
    var m1 = newRF().train(train, 'loss', FEATURES);
    printAuc('d. Site test (trained on ' + TRAIN_SITE + ', tested on ' + APPLY_SITE + ')',
      ee.FeatureCollection(cfg.ASSET_ROOT + '/risk_train_' + APPLY_SITE).classify(m1, 'p'));
  }
  if (TEST === 'f') {
    // Same as test a, but only the inputs that change over time (no terrain, roads,
    // settlements or boundary). If the AUC stays close to test a, the model is not just
    // memorising places; if it drops a lot, the fixed inputs carry real information.
    var DYN = ['d_loss', 'loss_dens', 'd_edge', 'forest_dens'];
    var cvf = ee.FeatureCollection(ee.List.sequence(0, FOLDS - 1).map(function(k) {
      k = ee.Number(k).int();
      var m = newRF().train(train.filter(ee.Filter.neq('fold', k)), 'loss', DYN);
      return train.filter(ee.Filter.eq('fold', k)).classify(m, 'p');
    })).flatten();
    printAuc('f. Spatial-block test, changing inputs only', cvf);
  }
  if (TEST === 'e') {
    var m2 = newRF().train(train, 'loss', FEATURES);
    print('e. Input importance (higher = used more)', ee.Dictionary(m2.explain().get('importance')));
  }
}

// ===== STEP 2: export the risk score ===================================================
if (STEP === 2) {
  var model2 = newRF().train(train, 'loss', FEATURES);
  var score = feat.select(FEATURES).classify(model2).rename('risk').float();  // forest at end of 2024 only
  Export.image.toAsset({image: score, description: 'risk_score_' + APPLY_SITE + '_2024',
    assetId: scoreId, region: aoi, crs: CRS, scale: SCALE, maxPixels: 1e10});
  print('Task created: open the Tasks tab and click Run. Then set STEP = 3.');
}

// ===== STEP 3: replay 2025 and map =====================================================
if (STEP === 3) {
  var risk = ee.Image(scoreId).select('risk');
  var forestMask = risk.mask().gt(0);
  var rule = feat.select('d_loss').multiply(-1).updateMask(forestMask).rename('rule');
  var gfc = ee.Image('UMD/hansen/global_forest_change_2025_v1_13');
  var loss25 = gfc.select('lossyear').unmask(0).eq(25).and(forestMask);
  var area = ee.Image.pixelArea().divide(1e4);   // ha

  // First get the top-10% and top-20% cut-off values as plain numbers,
  // so the map and the sums do not recompute them for every tile.
  risk.addBands(rule).reduceRegion({
    reducer: ee.Reducer.percentile([80, 90]), geometry: aoi, scale: SCALE, crs: CRS,
    maxPixels: 1e10, tileScale: 4
  }).evaluate(function(c, err) {
    if (err) { print('Cut-offs: error', err); return; }
    print('Cut-off values', c);

    var flags = {
      model_top10: risk.gte(c.risk_p90), rule_top10: rule.gte(c.rule_p90),
      model_top20: risk.gte(c.risk_p80), rule_top20: rule.gte(c.rule_p80)
    };
    var img = area.updateMask(forestMask).rename('forest_ha')
      .addBands(area.updateMask(loss25).rename('loss25_ha'));
    Object.keys(flags).forEach(function(n) {
      img = img.addBands(area.updateMask(forestMask.and(flags[n])).rename(n + '_forest_ha'))
               .addBands(area.updateMask(loss25.and(flags[n])).rename(n + '_loss25_ha'));
    });
    img.unmask(0).reduceRegion({
      reducer: ee.Reducer.sum(), geometry: aoi, scale: SCALE, crs: CRS, maxPixels: 1e10, tileScale: 4
    }).evaluate(function(s, err2) {
      if (err2) { print('Replay: error', err2); return; }
      print('Replay on ' + APPLY_SITE + ': forest at end of 2024 = ' + s.forest_ha.toFixed(0) +
            ' ha; lost in 2025 (Hansen) = ' + s.loss25_ha.toFixed(1) + ' ha');
      print(Object.keys(flags).map(function(n) {
        return n + ': watches ' + (100 * s[n + '_forest_ha'] / s.forest_ha).toFixed(1) +
               '% of the forest and captured ' + (100 * s[n + '_loss25_ha'] / s.loss25_ha).toFixed(1) +
               '% of 2025 loss';
      }).join('\n'));
    });

    // Map (0 lower, 1 top 20%, 2 top 10%)
    var riskClass = ee.Image(0).where(flags.model_top20, 1).where(flags.model_top10, 2)
      .updateMask(forestMask).rename('risk_class').toByte();
    Map.centerObject(aoi, 11);
    Map.addLayer(riskClass, {min: 0, max: 2, palette: ['f7f7f7', 'fd8d3c', 'bd0026']}, 'Risk: top 20% / top 10%');
    Map.addLayer(loss25.selfMask(), {palette: ['0000ff']}, '2025 loss (Hansen) - what actually happened');
    Map.addLayer(sites.boundary(APPLY_SITE).style({color: '1a9850', fillColor: '00000000', width: 2}), {}, 'Reserve boundary');

    if (EXPORT) {
      var out = risk.addBands(riskClass.float());
      Export.image.toAsset({image: out, description: 'risk_' + APPLY_SITE + '_2024',
        assetId: cfg.ASSET_ROOT + '/risk_' + APPLY_SITE + '_2024',
        region: aoi, crs: CRS, scale: SCALE, maxPixels: 1e10});
      Export.image.toDrive({image: out, description: 'risk_' + APPLY_SITE + '_2024_tif',
        folder: 'forestsight', fileNamePrefix: 'risk_' + APPLY_SITE + '_2024',
        region: aoi, crs: CRS, scale: SCALE, maxPixels: 1e10});
    }
  });
}
