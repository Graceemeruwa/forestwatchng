/**** D5b - Labelling app (owners: Abiodun, Member 3) ****
 * Compare BEFORE (dry 2024/25, left map) and AFTER (dry 2025/26, right map) Sentinel-2 images,
 * with high-resolution Google satellite imagery underneath, and label each point:
 *   0 = stable forest, 1 = forest loss, 2 = non-forest. Skip if you cannot tell.
 *
 * Before you run: set LABELLER, START and END (see the labelling guide).
 * Do NOT click Save in the editor: change the settings and click Run only,
 * so you never overwrite the shared script that other labellers are using.
 * Save every session: click "Save labels", then RUN the task in the Tasks tab.
 * The Console also prints a backup copy of your labels after each save.
 */
var cfg = require('users/forestwatchng/forestwatchng:lib/config');
var comp = require('users/forestwatchng/forestwatchng:lib/composites');

// ---- Settings ----------------------------------------------------------------
var SITE = 'omo';
var LABELLER = 'abiodun';            // your first name, lower case, no spaces
var START = 0;                       // first point (by pid) in this session
var END = 150;                       // stop before this point
var MODE = 'train';                  // 'train' now; 'validate' later (hides Hansen layer)
var POINTS = cfg.ASSET_ROOT + (MODE === 'train' ? '/cand_' : '/valpts_') + SITE;
// --------------------------------------------------------------------------------

var CLASSES = [
  {code: 0, name: 'Stable forest', color: '#1b7837'},
  {code: 1, name: 'Forest loss', color: '#d7191c'},
  {code: 2, name: 'Non-forest', color: '#7f7f7f'}
];

var base = ee.Image(cfg.ASSET_ROOT + '/comp_' + SITE + '_' + cfg.WINDOWS.baseline.label);
var recent = ee.Image(cfg.ASSET_ROOT + '/comp_' + SITE + '_' + cfg.WINDOWS.recent.label);
var last90 = ee.Image(cfg.ASSET_ROOT + '/comp_' + SITE + '_' + comp.last90Window().label);
var loss2025 = ee.Image('UMD/hansen/global_forest_change_2025_v1_13').select('lossyear').unmask(0).eq(25).selfMask();

// Per-band stretch so forest shows as dark green and clearings as pink/brown.
var falseColour = {bands: ['B11', 'B8', 'B4'], min: [0.05, 0.10, 0.01], max: [0.35, 0.45, 0.15]};
var trueColour = {bands: ['B4', 'B3', 'B2'], min: [0.01, 0.02, 0.01], max: [0.12, 0.12, 0.10], gamma: 1.2};
var ZOOM = 16;   // about 2.4 m per screen pixel: the 10 m pixel and its surroundings

// Two linked maps side by side: left = BEFORE, right = AFTER.
var left = ui.Map(), right = ui.Map();
[left, right].forEach(function(m) { m.setOptions('SATELLITE'); m.setControlVisibility({zoomControl: true, layerList: true}); });
ui.Map.Linker([left, right]);
left.addLayer(base, falseColour, 'BEFORE false colour (dry 2024/25)', true);
left.addLayer(base, trueColour, 'BEFORE true colour', false);
right.addLayer(recent, falseColour, 'AFTER false colour (dry 2025/26)', true);
right.addLayer(recent, trueColour, 'AFTER true colour', false);
right.addLayer(last90, falseColour, 'NOW false colour (last 90 days)', false);
right.addLayer(recent, {bands: ['VH'], min: -22, max: -10}, 'AFTER radar VH (bright = trees)', false);
if (MODE === 'train') {
  right.addLayer(loss2025, {palette: ['ffff00']}, 'Hansen 2025 loss (hint only)', false);
}
left.add(ui.Label('BEFORE: dry season 2024/25', {fontWeight: 'bold', position: 'bottom-left'}));
right.add(ui.Label('AFTER: dry season 2025/26', {fontWeight: 'bold', position: 'bottom-left'}));
var split = ui.SplitPanel({firstPanel: left, secondPanel: right, orientation: 'horizontal', wipe: false});

// Sentinel-2 layers that the high-resolution toggle hides.
var s2Layers = [left.layers().get(0), right.layers().get(0)];

// Point marker: the 10 m pixel (yellow square) plus crosshair ticks, on both maps.
var markerL = ui.Map.Layer(ee.Geometry.Point([0, 0]), {color: 'yellow'}, 'Point');
var markerR = ui.Map.Layer(ee.Geometry.Point([0, 0]), {color: 'yellow'}, 'Point');
left.layers().add(markerL); right.layers().add(markerR);


// ---- Time-series charts for the current point -------------------------------
// One dot per clear Sentinel-2 view (NBR) and per Sentinel-1 pass (VH) over the 30 m box,
// Nov 2023 to the end of the last-90-days window. Values are fetched first, then drawn,
// and a reply for an old point is ignored, so moving fast between points is safe.
var chartPanel = ui.Panel({style: {width: '360px'}});
var chartFor = null;

function seriesValues(col, band, box) {
  return col.map(function(img) {
    var v = img.select(band).reduceRegion({reducer: ee.Reducer.mean(), geometry: box, scale: 10}).get(band);
    return ee.Feature(null, {t: img.date().millis(), v: v});
  }).filter(ee.Filter.notNull(['v'])).sort('t').reduceColumns(ee.Reducer.toList(2), ['t', 'v']).get('list');
}

function makeChart(rows, label, title, vmin, vmax, colour) {
  if (!rows || rows.length === 0) {
    return ui.Label(title + ': no clear observations for this box.', {fontSize: '11px', color: 'gray'});
  }
  // x = decimal year (e.g. 2025.5 = early July 2025), y = value.
  var x = rows.map(function(r) { var d = new Date(r[0]); return d.getUTCFullYear() + d.getUTCMonth() / 12 + (d.getUTCDate() - 1) / 365; });
  var y = rows.map(function(r) { return r[1]; });
  var chart = ui.Chart.array.values({array: y, axis: 0, xLabels: x})
    .setChartType('ScatterChart')
    .setOptions({
      title: title, legend: {position: 'none'}, pointSize: 3, colors: [colour],
      hAxis: {title: 'Year', format: '####.#', viewWindow: {min: 2023.8, max: 2027.0}},
      vAxis: {title: label, viewWindow: {min: vmin, max: vmax}},
      chartArea: {width: '72%', height: '58%'}
    });
  chart.style().set({width: '350px', height: '190px'});
  return chart;
}

function drawCharts(p) {
  chartFor = p.pid;
  chartPanel.widgets().reset([ui.Label('Loading charts...', {fontSize: '11px', color: 'gray'})]);
  var box = ee.Geometry.Point([p.lon, p.lat]).buffer(15).bounds();
  var start = '2023-11-01', end = cfg.LAST90_END;
  var csPlus = ee.ImageCollection('GOOGLE/CLOUD_SCORE_PLUS/V1/S2_HARMONIZED');
  var s2 = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
    .filterBounds(box).filterDate(start, end)
    .linkCollection(csPlus, ['cs_cdf'])
    .map(function(img) {
      var clear = img.select('cs_cdf').gte(cfg.CS_THRESHOLD);
      return img.normalizedDifference(['B8', 'B12']).rename('NBR').updateMask(clear)
        .set('system:time_start', img.get('system:time_start'));
    });
  var s1 = ee.ImageCollection('COPERNICUS/S1_GRD')
    .filterBounds(box).filterDate(start, end)
    .filter(ee.Filter.eq('instrumentMode', 'IW'))
    .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VH'))
    .select('VH');
  ee.Dictionary({s2: seriesValues(s2, 'NBR', box), s1: seriesValues(s1, 'VH', box)}).evaluate(function(res, err) {
    if (chartFor !== p.pid) { return; }   // the user has moved on to another point
    if (err) {
      chartPanel.widgets().reset([ui.Label('Charts unavailable: ' + err, {color: 'red', fontSize: '11px'})]);
      return;
    }
    chartPanel.widgets().reset([
      ui.Label('BEFORE window = 2024.8 to 2025.2 on the year axis. AFTER window = 2025.8 to 2026.2.', {fontSize: '11px', color: 'gray'}),
      makeChart(res.s2, 'NBR', 'Optical NBR (forest ~0.4-0.7; clearing drops sharply)', -0.3, 0.8, '#1b7837'),
      makeChart(res.s1, 'VH dB', 'Radar VH dB (forest ~ -12 to -15; clearing falls lower)', -25, -8, '#2c7fb8')
    ]);
  });
}

// Side panel.
var panel = ui.Panel({style: {width: '380px', padding: '8px'}});
panel.add(ui.Label('ForestWatch NG - labelling', {fontWeight: 'bold', fontSize: '16px'}));
panel.add(ui.Label('Site: ' + SITE + ' | labeller: ' + LABELLER + ' | points ' + START + '-' + (END - 1)));
var status = ui.Label('Loading points...');
var current = ui.Label('', {fontWeight: 'bold'});
var counts = ui.Label('');
var lowConf = ui.Checkbox('Low confidence', false);
var qStyle = {fontSize: '12px', color: '#444444', margin: '0 8px'};
panel.add(ui.Label('Q1: Was the box mostly forest BEFORE? No: 2 Non-forest.', qStyle));
panel.add(ui.Label('Q2: Still mostly forest AFTER? Yes: 0 Stable forest. No: 1 Forest loss.', qStyle));
panel.add(ui.Label('Charts (scroll down): a sudden lasting drop = clearing; a flat line = no change.', qStyle));
panel.add(status).add(current);

var points = [];      // client-side list of {pid, lon, lat}
var labels = {};      // pid -> {cls, low}
var i = 0;

function updateCounts() {
  var c = {0: 0, 1: 0, 2: 0, skip: 0};
  Object.keys(labels).forEach(function(k) { c[labels[k].cls] += 1; });
  counts.setValue('Labelled: forest ' + c[0] + ' | loss ' + c[1] + ' | non-forest ' + c[2] + ' | skipped ' + c.skip);
}

function show(k) {
  if (points.length === 0) { return; }
  i = Math.max(0, Math.min(k, points.length - 1));
  var p = points[i];
  var pt = ee.Geometry.Point([p.lon, p.lat]);
  // 30 m box (3 x 3 Sentinel-2 pixels) around the point, plus ticks 20-45 m out.
  // Label what covers MOST of this box.
  var dx = 1 / (111320 * Math.cos(p.lat * Math.PI / 180)), dy = 1 / 110540;
  var x = p.lon, y = p.lat;
  var lines = [
    [[x - 15 * dx, y - 15 * dy], [x + 15 * dx, y - 15 * dy], [x + 15 * dx, y + 15 * dy], [x - 15 * dx, y + 15 * dy], [x - 15 * dx, y - 15 * dy]],
    [[x - 45 * dx, y], [x - 20 * dx, y]], [[x + 20 * dx, y], [x + 45 * dx, y]],
    [[x, y - 45 * dy], [x, y - 20 * dy]], [[x, y + 20 * dy], [x, y + 45 * dy]]
  ];
  var marker = ee.Geometry.MultiLineString(lines);
  markerL.setEeObject(marker);
  markerR.setEeObject(marker);
  left.setCenter(p.lon, p.lat, ZOOM);
  var done = labels[p.pid];
  status.setValue('Point ' + (i + 1) + ' of ' + points.length + '  (pid ' + p.pid + ')');
  current.setValue(done ? 'Current label: ' + (done.cls === 'skip' ? 'skipped' : CLASSES[done.cls].name) + (done.low ? ' (low confidence)' : '') : 'Not labelled yet');
  lowConf.setValue(done ? done.low : false, false);
  // Charts last, and guarded, so a chart problem can never stop labelling.
  try {
    drawCharts(p);
  } catch (err) {
    chartPanel.widgets().reset([ui.Label('Charts unavailable: ' + err, {color: 'red', fontSize: '11px'})]);
  }
}

function setLabel(cls) {
  var p = points[i];
  labels[p.pid] = {cls: cls, low: lowConf.getValue()};
  updateCounts();
  show(i + 1);
}

CLASSES.forEach(function(c) {
  panel.add(ui.Button({label: c.code + '  ' + c.name, style: {stretch: 'horizontal', color: c.color},
    onClick: function() { setLabel(c.code); }}));
});
panel.add(ui.Button({label: 'Skip / cannot tell', style: {stretch: 'horizontal'}, onClick: function() { setLabel('skip'); }}));
panel.add(lowConf);
var hiRes = ui.Checkbox('Show high-resolution imagery only', false);
hiRes.onChange(function(on) { s2Layers.forEach(function(l) { l.setShown(!on); }); });
panel.add(hiRes);
panel.add(ui.Panel([
  ui.Button('< Previous', function() { show(i - 1); }),
  ui.Button('Next >', function() { show(i + 1); })
], ui.Panel.Layout.flow('horizontal')));
var jump = ui.Textbox({placeholder: 'Go to point number'});
jump.onChange(function(v) { show(parseInt(v, 10) - 1); });
panel.add(jump);
panel.add(counts);
panel.add(chartPanel);

panel.add(ui.Button({label: 'Save labels (creates a task)', style: {stretch: 'horizontal', fontWeight: 'bold'}, onClick: function() {
  var feats = points.filter(function(p) { return labels[p.pid] !== undefined; }).map(function(p) {
    var l = labels[p.pid];
    return ee.Feature(ee.Geometry.Point([p.lon, p.lat]), {
      pid: p.pid, site: SITE, labeller: LABELLER, mode: MODE,
      class: l.cls === 'skip' ? -1 : l.cls, low_conf: l.low ? 1 : 0
    });
  });
  var name = 'labels_' + MODE + '_' + SITE + '_' + LABELLER + '_' + START + '_' + END;
  Export.table.toAsset({collection: ee.FeatureCollection(feats), description: name, assetId: cfg.ASSET_ROOT + '/' + name});
  print('Backup of ' + feats.length + ' labels (pid:class:low)',
    Object.keys(labels).sort().map(function(k) { return k + ':' + labels[k].cls + ':' + (labels[k].low ? 1 : 0); }).join(' '));
  status.setValue('Saved. Now RUN the task "' + name + '" in the Tasks tab.');
}}));

panel.add(ui.Label('Compare BEFORE (left map) with AFTER (right map). Tick "high-resolution only" to see ' +
  'what the land cover is. More layers (true colour, radar, last 90 days) are in each map\'s Layers list.',
  {fontSize: '11px', color: 'gray'}));

// Side panel on the left, swipe maps filling the rest of the screen.
split.style().set('stretch', 'both');
ui.root.clear();
ui.root.setLayout(ui.Panel.Layout.flow('horizontal'));
ui.root.add(panel);
ui.root.add(split);

// Load the points for this session.
ee.FeatureCollection(POINTS).sort('pid').toList(END - START, START).evaluate(function(list) {
  points = list.map(function(f) {
    return {pid: f.properties.pid, lon: f.geometry.coordinates[0], lat: f.geometry.coordinates[1]};
  });
  updateCounts();
  show(0);
});
